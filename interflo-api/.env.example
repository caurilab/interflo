APP_NAME=Interflo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://api.interflo.test

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Développement : PostgreSQL par défaut (base `interflo`).
# ⚠️ HYPOTHÈSE signalée : PostgreSQL est le choix de BOS ; pour Interflo il
# est « à confirmer, pas à recopier par défaut » (docs/04-architecture.md §3.1).
# La bascule a été ordonnée par la mission du 2026-09-26 malgré cette réserve.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=interflo
DB_USERNAME=houdini
DB_PASSWORD=
# Repli local sans serveur PostgreSQL (décommenter et commenter le bloc pgsql) :
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
# ⚠️ D-002 §4.3 : en dev, `sync` pour que le flush Redis → PostgreSQL
# (App\Jobs\PersistAnswer) s'exécute sans worker. En production : `redis`
# (Horizon) pour sortir PostgreSQL du chemin critique du pic.
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Reverb (temps réel, D-002) -----------------------------
# Identifiants générés par `php artisan reverb:install` (uniques par
# instance — ne pas committer de valeurs réelles).
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- IA (Laravel AI SDK, laravel/ai) --------------------------
# Fournisseur par défaut : DeepSeek (config/ai.php, driver natif
# `deepseek`, endpoint https://api.deepseek.com/v1). Ne pas committer
# de vraie clé — à renseigner localement (ou via un secret d'environnement).
DEEPSEEK_API_KEY=

# ──────────────────────────────────────────────────────────────────────
# Réglages du jeu Interflo (config/interflo.php)
# ⚠️ Aucune valeur numérique n'est validée : chaque valeur ci-dessous est
# un « point de départ non validé », à corriger au premier tournage.
# Les trois valeurs scellées par décision PO (4 propositions, 5 manches,
# 1/3/5 gagnants) ne figurent PAS ici : ce sont des règles du jeu, pas des
# réglages — voir config/interflo.php.
# ──────────────────────────────────────────────────────────────────────

# Plancher anti-automatisation, en millisecondes (I-30). ⚠️ Point de départ non validé.
INTERFLO_ANTI_AUTOMATION_FLOOR_MS=800
# Durée de la fenêtre de réponse personnelle, en secondes (I-31). ⚠️ Point de départ non validé.
INTERFLO_ANSWER_WINDOW_SECONDS=10
# Pire décalage de diffusion attendu (enveloppe serveur), en secondes (EX-20). ⚠️ Point de départ non validé.
INTERFLO_SERVER_ENVELOPE_SECONDS=15
# Période de rotation du code d'appairage, en secondes (I-18, ordre de grandeur 15-30). ⚠️ Point de départ non validé.
INTERFLO_PAIRING_CODE_ROTATION_SECONDS=20
# Longueur du code court d'appairage (I-14, ordre de grandeur 6). ⚠️ Point de départ non validé.
INTERFLO_SHORT_CODE_LENGTH=6
# Alphabet du code court, SANS caractères ambigus (EX-03 : pas de 0/O, 1/I/L, 5/S).
INTERFLO_SHORT_CODE_ALPHABET=ABCDEFGHJKMNPQRTUVWXYZ2346789
# Nombre maximum de relances d'un tour buzzer par l'animateur (I-7, ordre de grandeur 3). ⚠️ Point de départ non validé.
INTERFLO_BUZZER_MAX_RELAUNCHES=3
# Pourcentage de questions de culture générale (I-32) — NON ARRÊTÉ par le PO. Laisser vide (null).
INTERFLO_GENERAL_CULTURE_PERCENT=

# Longueur du code OTP de vérification téléphone (I-8). ⚠️ Point de départ non validé.
INTERFLO_OTP_LENGTH=6
# Durée de validité d'un code OTP, en secondes. ⚠️ Point de départ non validé.
INTERFLO_OTP_TTL_SECONDS=300
# Tentatives max de saisie par challenge OTP. ⚠️ Point de départ non validé.
INTERFLO_OTP_MAX_ATTEMPTS=5
# Demandes de code max par numéro et par heure. ⚠️ Point de départ non validé.
INTERFLO_OTP_REQUEST_THROTTLE_PER_HOUR=10
# Tentatives de vérification max par numéro et par minute (filet additionnel,
# introduit par le backend — non demandé par la mission). ⚠️ Point de départ non validé.
INTERFLO_OTP_VERIFY_THROTTLE_PER_MINUTE=10
