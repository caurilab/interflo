# =============================================================
# Interflo — variables d'environnement (gabarit)
#
# ⚠️ Ce fichier est un POINT DE DÉPART, pas une configuration
#    validée. La couche temps réel n'est pas conçue : les
#    variables qui la concernent sont volontairement absentes.
#    Voir docs/04-architecture.md §5.
# =============================================================

APP_NAME=Interflo
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost

# --- Base de données ---------------------------------------
# ⚠️ Base SÉPARÉE de celle de BOS (I-35). Point d'entrée,
#    service et base vont ensemble ou la séparation est
#    décorative.
DB_CONNECTION=
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# --- Lien avec Tvflo BOS ------------------------------------
# ⚠️ UNIDIRECTIONNEL ET ANTICIPÉ (I-36).
#    Interflo copie le contexte AVANT l'émission et ne fait
#    AUCUN appel synchrone vers BOS pendant une fenêtre de jeu.
BOS_API_URL=
BOS_API_TOKEN=

# --- Empreinte audio (ACRCloud) -----------------------------
# Service : Live Channel Detection. Voir docs/08-chaine-de-mesure.md
ACRCLOUD_HOST=
ACRCLOUD_ACCESS_KEY=
ACRCLOUD_ACCESS_SECRET=

# --- Paramètres de jeu --------------------------------------
# ⚠️ AUCUNE de ces valeurs n'est validée. Points de départ à
#    corriger au premier tournage. Ne jamais les mettre en dur
#    dans le code : elles sont configurables par tenant (I-31).
#
# Plancher anti-automatisation (I-30) — DISTINCT de la durée
# de fenêtre. Seuil sous lequel le serveur rejette.
GAME_MIN_ANSWER_MS=

# Durée de la fenêtre de réponse (I-31), par défaut.
GAME_WINDOW_MS=

# Pire décalage attendu. L'enveloppe serveur = fenêtre + ceci.
# La fenêtre est PERSONNELLE, pas absolue (EX-20).
GAME_MAX_BROADCAST_DELAY_MS=

# Période de rotation du code d'appairage (I-18).
PAIRING_CODE_ROTATION_S=

# --- Couche temps réel --------------------------------------
# ⚠️ NON CONÇUE. Aucun transport n'a été choisi.
#    Ne pas remplir ces variables « par défaut » en reprenant
#    ce qui existe dans BOS : le profil de charge n'a rien à
#    voir. Voir docs/04-architecture.md §5.
