# =============================================================
# Interflo — variables d'environnement (gabarit)
#
# ⚠️ Toutes les valeurs de jeu (INTERFLO_*) sont des POINTS DE
#    DÉPART NON VALIDÉS, configurables par tenant (I-31). Une
#    variable absente de ce fichier prend la valeur par défaut
#    définie dans config/interflo.php — ne jamais mettre ces
#    valeurs en dur dans le code.
#
# ⚠️ Les sections ACRCloud et BOS ne sont PAS encore consommées
#    par le code (aucun config/services.php, aucun appel). Elles
#    anticipent la chaîne de mesure (I-43) et le couplage I-36.
# =============================================================

APP_NAME=Interflo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en

# --- Base de données ---------------------------------------
# ⚠️ Base SÉPARÉE de celle de BOS (I-35). Point d'entrée,
#    service et base vont ensemble ou la séparation est
#    décorative.
# PostgreSQL 17 est la base décidée (session 2). SQLite reste un
# repli sans serveur (décommenter les deux lignes ci-dessous).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=interflo
DB_USERNAME=interflo
DB_PASSWORD=interflo
# DB_CONNECTION=sqlite
# DB_DATABASE=/chemin/absolu/vers/database.sqlite

# --- Cache, file d'attente, sessions -----------------------
# ⚠️ Aujourd'hui : cache/file/queue/session sur base de données.
#    Redis deviendra nécessaire à la couche temps réel (D-002,
#    PROPOSÉE) mais n'est pas encore consommé par le code.
CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
BROADCAST_CONNECTION=log
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# --- Lien avec Tvflo BOS ------------------------------------
# ⚠️ UNIDIRECTIONNEL ET ANTICIPÉ (I-36).
#    Interflo copie le contexte AVANT l'émission et ne fait
#    AUCUN appel synchrone vers BOS pendant une fenêtre de jeu.
# ⚠️ Pas encore consommé par le code (config/services.php à écrire).
BOS_API_URL=
BOS_API_TOKEN=

# --- Empreinte audio (ACRCloud) -----------------------------
# Service : Live Channel Detection (I-43). Identifiants à demander
# au PO au moment d'implémenter la chaîne de mesure.
# ⚠️ Pas encore consommé par le code.
ACRCLOUD_HOST=
ACRCLOUD_ACCESS_KEY=
ACRCLOUD_ACCESS_SECRET=

# --- Paramètres de jeu (INTERFLO_*) -------------------------
# ⚠️ AUCUNE de ces valeurs n'est validée. Points de départ à
#    corriger au premier tournage. Les valeurs ci-dessous sont
#    les défauts de config/interflo.php.

# Plancher anti-automatisation (I-30) — DISTINCT de la durée de
# fenêtre. Seuil sous lequel le serveur rejette.
INTERFLO_ANTI_AUTOMATION_FLOOR_MS=800

# Durée de la fenêtre de réponse PERSONNELLE, en secondes (I-31).
INTERFLO_ANSWER_WINDOW_SECONDS=10

# Pire décalage attendu (EX-20). L'enveloppe serveur = fenêtre + ceci.
INTERFLO_SERVER_ENVELOPE_SECONDS=15

# Tolérance d'horloge client, en millisecondes (EX-16 / EX-17).
INTERFLO_CLOCK_TOLERANCE_MS=2000

# Longueur du token de pilotage animateur (⚠️ PROVISOIRE : l'auth
# de la console tablette n'est pas spécifiée nulle part).
INTERFLO_PILOT_TOKEN_LENGTH=48

# Période de rotation du code d'appairage, en secondes (I-18).
INTERFLO_PAIRING_CODE_ROTATION_SECONDS=20

# Longueur du code court d'appairage (I-14).
INTERFLO_SHORT_CODE_LENGTH=6

# Alphabet du code court, sans caractères ambigus (EX-03).
INTERFLO_SHORT_CODE_ALPHABET=ABCDEFGHJKMNPQRTUVWXYZ2346789

# Nombre maximum de relances d'un tour buzzer (I-7).
INTERFLO_BUZZER_MAX_RELAUNCHES=3

# Pourcentage de questions de culture générale (I-32) — NON arrêté.
INTERFLO_GENERAL_CULTURE_PERCENT=

# --- Vérification du numéro de téléphone (I-8) --------------
# ⚠️ Points de départ non validés (voir config/interflo.php).
INTERFLO_OTP_LENGTH=6
INTERFLO_OTP_TTL_SECONDS=300
INTERFLO_OTP_MAX_ATTEMPTS=5
INTERFLO_OTP_REQUEST_THROTTLE_PER_HOUR=10
INTERFLO_OTP_VERIFY_THROTTLE_PER_MINUTE=10

# --- Couche temps réel --------------------------------------
# ⚠️ NON IMPLÉMENTÉE. La décision D-002 (Reverb + Redis + Octane)
#    est PROPOSÉE, pas validée. Le transport en vigueur est le
#    polling HTTP provisoire de la session 4.
